#!/bin/bash
# Install the macOS Bash environment without Linux desktop configuration.
set -euo pipefail
IFS=$'\n\t'
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=tools/install_helpers.sh
source "${SCRIPT_DIR}/tools/install_helpers.sh"

CONSOLE_PKGS=(git curl unzip fastfetch toilet midnight-commander nano micro eza lolcat)

# shellcheck source=tools/mac_environment.sh
source "${SCRIPT_DIR}/tools/mac_environment.sh"

# Print the supported shell-only installation modes.
usage() {
  echo "usage: ./install_mac <-c|-d|-p>"
  echo "-c   install missing console commands with Homebrew and shell configuration"
  echo "-d   install shell configuration only (dependencies must already exist)"
  echo "-p   print Homebrew formula names"
  echo "Requires macOS, Bash as the account's default shell, and an existing Homebrew installation."
}

# Install formulas only when their corresponding executable is missing from PATH.
install_console() {
  local package executable
  local missing=()
  for package in "${CONSOLE_PKGS[@]}"; do
    executable="$package"
    [[ "$package" != midnight-commander ]] || executable=mc
    if command -v "$executable" >/dev/null 2>&1; then
      printf 'Already available: %s (skipping %s)\n' "$executable" "$package"
    else
      missing+=("$package")
    fi
  done
  if [[ "${#missing[@]}" -gt 0 ]]; then
    "$BREW_COMMAND" install "${missing[@]}"
  else
    echo "All console commands are already available; no packages to install."
  fi
}

# Back up a destination before replacing its contents or symlink.
prepare_destination() {
  local dest="$1"
  if [[ -L "$dest" ]]; then
    rm -- "$dest"
  elif [[ -e "$dest" ]]; then
    backup_existing "$dest"
  fi
  mkdir -p -- "$(dirname -- "$dest")"
}

# Link one explicitly selected shell configuration into the user home.
link_shell_config() {
  local source="$1"
  local destination="${HOME}/$2"
  [[ -e "$source" ]] || die "Missing source: $source"
  prepare_destination "$destination"
  ln -s -- "$source" "$destination"
}

# Install portable editor settings and a Bash login entry point for Homebrew.
install_dotfiles() {
  local brew_prefix
  brew_prefix="$("$BREW_COMMAND" --prefix)"
  link_shell_config "${SCRIPT_DIR}/mac/.bashrc" .bashrc
  link_shell_config "${SCRIPT_DIR}/home/.config/micro" .config/micro
  link_shell_config "${SCRIPT_DIR}/home/.config/mc" .config/mc

  prepare_destination "${HOME}/.bash_profile"
  {
    echo '# Initialize Homebrew and load interactive Bash settings.'
    printf 'eval "$(%q shellenv)"\n' "$BREW_COMMAND"
    printf 'if [[ $- == *i* ]]; then source "$HOME/.bashrc"; fi\n'
  } > "${HOME}/.bash_profile"

  if [[ -d "$brew_prefix/share/nano" ]]; then
    prepare_destination "${HOME}/.nanorc"
    {
      printf 'set constantshow\nset linenumbers\nset historylog\n'
      printf 'include "%s/share/nano/*.nanorc"\n' "$brew_prefix"
    } > "${HOME}/.nanorc"
  else
    echo "No Homebrew nano syntax directory; leaving ~/.nanorc unchanged."
  fi
}

# ---------------------- main ------------------------------------------
case "${1:-}" in
  "") usage ;;
  -p) printf '%s\n' "${CONSOLE_PKGS[@]}" ;;
  -c|-d)
    require_mac_environment
    if [[ "$1" == -c ]]; then
      install_console
    fi
    install_dotfiles
    ;;
  *) usage >&2; exit 1 ;;
esac
